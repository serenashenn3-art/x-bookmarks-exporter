{
  "manifest_version": 3,
  "name": "X Bookmarks Exporter",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Export and categorize your X bookmarks with AI-powered tagging and multi-format export.",
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "activeTab"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "Open X Bookmarks Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*/bookmarks*", "https://twitter.com/*/bookmarks*", "https://x.com/i/bookmarks*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
